CREATE TRIGGER tD_HOTLI AFTER DELETE ON HOTLIST
   REFERENCING OLD AS OLD FOR EACH ROW MODE DB2SQL
WHEN (0 < (SELECT count(*) FROM HOTLIST_ADDRESS WHERE
 HOTLIST_ADDRESS.HOTLIST_ID = old.HOTLIST_ID))
 BEGIN ATOMIC
     SIGNAL SQLSTATE '75001' ('Cannot delete HOTLIST because
 HOTLIST_ADDRESS exists.');
 END
 !!
CREATE TRIGGER tD_HOTL2 AFTER DELETE ON HOTLIST
   REFERENCING OLD AS OLD FOR EACH ROW MODE DB2SQL
WHEN (0 < (SELECT count(*) FROM HOTLIST_PHONE WHERE
 HOTLIST_PHONE.HOTLIST_ID = old.HOTLIST_ID))
 BEGIN ATOMIC
     SIGNAL SQLSTATE '75001' ('Cannot delete HOTLIST because
 HOTLIST_PHONE exists.');
 END
 !!

CREATE TRIGGER tI_HOTLI AFTER INSERT ON HOTLIST_ADDRESS
   REFERENCING NEW AS NEW FOR EACH ROW MODE DB2SQL
WHEN ((0 = (SELECT count(*) FROM HOTLIST WHERE new.HOTLIST_ID =
 HOTLIST.HOTLIST_ID))
)
 BEGIN ATOMIC
       SIGNAL SQLSTATE '75001' ('Cannot insert HOTLIST_ADDRESS because
 HOTLIST does not exist.');
 END
 !!

